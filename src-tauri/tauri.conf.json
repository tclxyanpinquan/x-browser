{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "x-browser",
  "version": "1.2.0",
  "identifier": "com.xbrowser.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9708",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "x-browser",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "entitlements": "entitlements.plist",
      "providerShortName": "2VH263HBZJ",
      "signingIdentity": "Developer ID Application: yuchen xiu (2VH263HBZJ)",
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
